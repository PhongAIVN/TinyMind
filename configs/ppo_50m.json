{
  "prompts": "dataset/toy_math/train.jsonl",
  "eval_prompts": "dataset/toy_math/eval.jsonl",
  "init_from": "checkpoints/50m/think.pt",
  "out_dir": "checkpoints/50m",
  "checkpoint_name": "ppo.pt",
  "algo": "ppo",
  "mode": "think",
  "steps": 150,
  "prompts_per_step": 32,
  "group_size": 1,
  "max_new_tokens": 96,
  "temperature": 1.0,
  "lr": 2e-06,
  "min_lr": 2e-07,
  "warmup_steps": 10,
  "beta_kl": 0.02,
  "clip_eps": 0.2,
  "inner_epochs": 2,
  "gamma": 1.0,
  "lam": 0.95,
  "critic_lr": 1e-05,
  "log_interval": 1,
  "eval_interval": 25,
  "eval_limit": 300,
  "save_interval": 50,
  "dtype": "bf16",
  "attention": "sdpa",
  "device": "cuda",
  "seed": 0
}
