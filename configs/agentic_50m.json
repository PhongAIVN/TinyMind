{
  "prompts": "dataset/toy_math/train.jsonl",
  "eval_prompts": "dataset/toy_math/eval.jsonl",
  "init_from": "checkpoints/50m/tool.pt",
  "out_dir": "checkpoints/50m",
  "checkpoint_name": "agentic.pt",
  "algo": "grpo",
  "mode": "tools",
  "steps": 100,
  "prompts_per_step": 8,
  "group_size": 4,
  "max_new_tokens": 48,
  "temperature": 1.0,
  "lr": 2e-06,
  "min_lr": 2e-07,
  "warmup_steps": 10,
  "beta_kl": 0.02,
  "clip_eps": 0.2,
  "inner_epochs": 1,
  "log_interval": 1,
  "eval_interval": 25,
  "eval_limit": 300,
  "save_interval": 50,
  "dtype": "bf16",
  "attention": "sdpa",
  "device": "cuda",
  "seed": 0
}
