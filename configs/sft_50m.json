{
  "train_bin": "dataset/sft/train.jsonl",
  "eval_bin": "dataset/sft/eval.jsonl",
  "out_dir": "checkpoints/50m",
  "init_from": "checkpoints/50m/pretrain.pt",
  "seq_len": 512,
  "batch_size": 16,
  "accum_steps": 8,
  "max_steps": 2000,
  "warmup_steps": 100,
  "lr": 0.0001,
