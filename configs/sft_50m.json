  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "log_interval": 10,
  "eval_interval": 200,
  "eval_batches": 20,
  "save_interval": 500,
  "dtype": "bf16",
  "attention": "sdpa",
  "device": "cuda",
  "seed": 0
}
