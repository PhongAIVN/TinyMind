        <mxCell id="bridge_dpo_rlaif" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7f8c8d;dashed=1;" edge="1" parent="1" source="dpo_card" target="rlaif_card">
