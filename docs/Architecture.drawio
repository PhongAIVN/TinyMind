        <!-- ========================================================================= -->
        <!-- SWIMLANE 2: SFT (SUPERVISED FINE-TUNING) DETAILS                          -->
        <!-- ========================================================================= -->
        <!-- SFT: Column Titles -->
        <mxCell id="sft_col1_title" value="A. Dữ liệu Hội thoại &amp; Chat Template" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2b5b84;" vertex="1" parent="1">
          <mxGeometry x="1560" y="155" width="370" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sft_col2_title" value="B. Cơ chế Masking Nhãn &amp; Model SFT" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#900c3f;" vertex="1" parent="1">
          <mxGeometry x="1990" y="155" width="440" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sft_col3_title" value="C. Loss, Tối ưu &amp; Suy luận (Inference)" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#196f3d;" vertex="1" parent="1">
          <mxGeometry x="2500" y="155" width="370" height="25" as="geometry" />
        </mxCell>

        <!-- SFT: Column 1 (Data & Chat Template) -->
        <mxCell id="sft_raw" value="&lt;b&gt;1. Tập hội thoại có cấu trúc (JSONL)&lt;/b&gt;&lt;br&gt;&lt;i&gt;dataset/sft/sft_data.jsonl&lt;/i&gt;&lt;br&gt;Mỗi dòng là một phiên đối thoại đa lượt (Multi-turn):&lt;br&gt;[ {&quot;role&quot;: &quot;system&quot;, &quot;content&quot;: &quot;...&quot;},&lt;br&gt;&amp;nbsp;&amp;nbsp;{&quot;role&quot;: &quot;user&quot;, &quot;content&quot;: &quot;...&quot;},&lt;br&gt;&amp;nbsp;&amp;nbsp;{&quot;role&quot;: &quot;assistant&quot;, &quot;content&quot;: &quot;...&quot;} ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1560" y="195" width="370" height="85" as="geometry" />
        </mxCell>

        <mxCell id="sft_tpl" value="&lt;b&gt;2. Áp dụng Chat Template (Đóng gói prompt)&lt;/b&gt;&lt;br&gt;Bọc câu nói bằng các token định danh vai trò:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;&amp;lt;|im_start|&amp;gt;system&lt;/b&gt;\nBạn là trợ lý AI hữu ích...&lt;b&gt;&amp;lt;|im_end|&amp;gt;&lt;/b&gt;\n&lt;br&gt;&lt;b&gt;&amp;lt;|im_start|&amp;gt;user&lt;/b&gt;\nThủ đô Việt Nam ở đâu?&lt;b&gt;&amp;lt;|im_end|&amp;gt;&lt;/b&gt;\n&lt;br&gt;&lt;b&gt;&amp;lt;|im_start|&amp;gt;assistant&lt;/b&gt;\nThủ đô Việt Nam là Hà Nội.&lt;b&gt;&amp;lt;|im_end|&amp;gt;&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1560" y="310" width="370" height="115" as="geometry" />
        </mxCell>

        <mxCell id="sft_tok" value="&lt;b&gt;3. Tokenize toàn bộ chuỗi hội thoại&lt;/b&gt;&lt;br&gt;&lt;i&gt;SFTDataset&lt;/i&gt; (&lt;i&gt;dataset/lm_dataset.py&lt;/i&gt;)&lt;br&gt;Chuyển toàn bộ chuỗi text thành &lt;b&gt;input_ids&lt;/b&gt; &lt;i&gt;(B, T_seq)&lt;/i&gt;&lt;br&gt;Giới hạn độ dài max_length (ví dụ 1024), pad về cùng kích thước" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1560" y="455" width="370" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sft_diff" value="&lt;b&gt;Điểm khác biệt cốt lõi Pretrain vs SFT:&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• &lt;b&gt;Pretrain:&lt;/b&gt; Mô hình chỉ biết &quot;nói tiếp&quot; câu văn vô định hướng, có thể tự hỏi tự trả lời hoặc nói linh tinh.&lt;br&gt;• &lt;b&gt;SFT:&lt;/b&gt; Định hình tư duy mô hình thành &lt;b&gt;Trợ lý (Assistant)&lt;/b&gt;, học cách lắng nghe câu hỏi của User và phản hồi lễ phép, đúng trọng tâm.&lt;br&gt;• Dữ liệu SFT có số lượng ít hơn nhiều (hàng chục nghìn mẫu) nhưng được biên soạn tỉ mỉ với chất lượng cao." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1560" y="555" width="370" height="150" as="geometry" />
        </mxCell>

        <!-- SFT: Column 2 (Masking & Model) -->
        <mxCell id="sft_mask" value="&lt;b&gt;CƠ CHẾ MASKING NHÃN — QUY TẮC SỐ 1 CỦA SFT&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;input_ids:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;[&amp;lt;|im_start|&amp;gt;, user, ..., &amp;lt;|im_end|&amp;gt;, &amp;lt;|im_start|&amp;gt;, assistant, Thủ, đô, ..., &amp;lt;|im_end|&amp;gt;]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;labels (sinh bởi generate_labels):&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#b85450&quot;&gt;&lt;b&gt;[ &amp;nbsp;−100, &amp;nbsp;&amp;nbsp;&amp;nbsp;−100, ..., &amp;nbsp;&amp;nbsp;−100, &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;−100, &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;t_thủ, t_đô, ..., t_eos &amp;nbsp;]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;▲&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;▲&lt;br&gt;&lt;b&gt;System + User = −100 (BỊ LOẠI TRỪ)&lt;/b&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;CHỈ HỌC TOKEN ASSISTANT!&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Tại sao bắt buộc phải Mask?&lt;/i&gt;&lt;br&gt;Nếu không mask nhãn câu hỏi của User, mô hình sẽ tốn tham số để học thuộc lòng cả câu hỏi của người dùng. Masking giúp mô hình chỉ tập trung 100% khả năng để học cách trả lời của Assistant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1990" y="195" width="440" height="235" as="geometry" />
        </mxCell>

        <mxCell id="sft_model" value="&lt;b&gt;Mô hình CausalLM (SFT Mode)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• Khởi tạo trọng số từ: &lt;b&gt;checkpoints/pretrain.pt&lt;/b&gt;&lt;br&gt;• Nhận toàn bộ chuỗi &lt;i&gt;input_ids&lt;/i&gt; &lt;i&gt;(B, T_seq)&lt;/i&gt;&lt;br&gt;• Forward qua Token Embedding → L Blocks (Attention + SwiGLU) → lm_head&lt;br&gt;• Xuất ra phân phối xác suất: &lt;b&gt;logits&lt;/b&gt; &lt;i&gt;(B, T_seq, V)&lt;/i&gt;&lt;br&gt;• Huấn luyện Full-parameter (toàn bộ 2.4M tham số đều được tối ưu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1990" y="460" width="440" height="150" as="geometry" />
        </mxCell>

        <mxCell id="sft_pair" value="&lt;b&gt;Ghép cặp tính Loss:&lt;/b&gt;&lt;br&gt;logits &lt;i&gt;(B, T_seq, V)&lt;/i&gt; &amp;nbsp;&amp;nbsp;&amp;amp;&amp;nbsp;&amp;nbsp; labels &lt;i&gt;(B, T_seq)&lt;/i&gt; mang giá trị −100 ở prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1990" y="645" width="440" height="55" as="geometry" />
        </mxCell>

        <!-- SFT: Column 3 (Loss, Optim, Checkpoint & Inference) -->
        <mxCell id="sft_loss" value="&lt;b&gt;Masked Cross-Entropy Loss&lt;/b&gt;&lt;br&gt;F.cross_entropy(logits, labels, &lt;b&gt;ignore_index = −100&lt;/b&gt;)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;L_{SFT} = − 1/N_{ast} ∑_{t ∈ Assistant} log P(y_t | prompt, y_{&amp;lt;t})&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Toàn bộ token System và User bị triệt tiêu loss hoàn toàn!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2500" y="195" width="370" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sft_optim" value="&lt;b&gt;Chiến lược huấn luyện SFT:&lt;/b&gt;&lt;br&gt;• Optimizer: &lt;b&gt;AdamW&lt;/b&gt;&lt;br&gt;• Learning rate nhỏ: &lt;b&gt;1e−5 ~ 5e−5&lt;/b&gt; (tránh hiện tượng quên thảm hoạ / catastrophic forgetting tri thức pretrain)&lt;br&gt;• Scheduler: Cosine Annealing with Warmup&lt;br&gt;• Gradient Accumulation: Gom nhiều bước để có batch lớn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2500" y="310" width="370" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sft_ckpt" value="&lt;b&gt;ĐẦU RA SFT: CHAT / INSTRUCT MODEL&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;3&quot; color=&quot;#196f3d&quot;&gt;&lt;b&gt;checkpoints/sft.pt&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mô hình biết trò chuyện, tuân theo chỉ dẫn, xưng hô lịch sự&lt;br&gt;Sẵn sàng phục vụ người dùng hoặc tinh chỉnh tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2500" y="445" width="370" height="75" as="geometry" />
        </mxCell>

        <mxCell id="sft_infer" value="&lt;b&gt;Suy luận sinh chữ (Inference — &lt;i&gt;inference/generate.py&lt;/i&gt;)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;1. Người dùng nhập câu hỏi vào console / web UI&lt;br&gt;2. Ghép prompt: &lt;font face=&quot;Courier New&quot;&gt;&amp;lt;|im_start|&amp;gt;user\n{câu_hỏi}&amp;lt;|im_end|&amp;gt;\n&amp;lt;|im_start|&amp;gt;assistant\n&lt;/font&gt;&lt;br&gt;3. &lt;b&gt;Autoregressive Decoding:&lt;/b&gt; Sinh từng token tiếp theo&lt;br&gt;4. Tăng tốc bằng &lt;b&gt;KV Cache&lt;/b&gt; (&lt;i&gt;core/kv_cache.py&lt;/i&gt;) lưu K, V quá khứ&lt;br&gt;5. Lấy mẫu: Temperature, Top-p (nucleus), Top-k sampling&lt;br&gt;6. Dừng lại khi gặp token kết thúc &lt;b&gt;&amp;lt;|im_end|&amp;gt;&lt;/b&gt; hoặc đạt max_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2500" y="545" width="370" height="160" as="geometry" />
        </mxCell>

        <!-- SFT Edges (Flow) -->
        <mxCell id="sfte_1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sft_raw" target="sft_tpl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sfte_2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sft_tpl" target="sft_tok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sfte_3" value="input_ids" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="sft_tok" target="sft_mask">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1960" y="490" />
              <mxPoint x="1960" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sfte_4" value="input_ids (B, T)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="sft_mask" target="sft_model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sfte_5" value="logits" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="sft_model" target="sft_pair">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sfte_6" value="labels (-100)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;exitX=0;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="sft_mask" target="sft_pair">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1965" y="407" />
              <mxPoint x="1965" y="673" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sfte_7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sft_pair" target="sft_loss">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2460" y="673" />
              <mxPoint x="2460" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sfte_8" value="backward" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="sft_loss" target="sft_optim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sfte_9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sft_optim" target="sft_ckpt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sfte_10" value="nạp mô hình sinh chữ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#196f3d;" edge="1" parent="1" source="sft_ckpt" target="sft_infer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- FUTURE ROADMAP PHASES: LORA, DPO, RLAIF DETAILS                           -->
        <!-- ========================================================================= -->
        <mxCell id="lora_card" value="&lt;b&gt;TINH CHỈNH HIỆU QUẢ THAM SỐ (PEFT — LoRA)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• &lt;b&gt;Nguyên lý:&lt;/b&gt; Đóng băng hoàn toàn trọng số gốc &lt;i&gt;W₀&lt;/i&gt; (&lt;font color=&quot;#666666&quot;&gt;requires_grad = False&lt;/font&gt;)&lt;br&gt;• &lt;b&gt;Phân rã ma trận hạng thấp:&lt;/b&gt; Tiêm hai ma trận A và B:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;ΔW = (α / r) · B · A&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;+ &lt;i&gt;A ∈ ℝ^{r × d_in}&lt;/i&gt; — khởi tạo Gaussian N(0, 0.02)&lt;br&gt;&amp;nbsp;&amp;nbsp;+ &lt;i&gt;B ∈ ℝ^{d_out × r}&lt;/i&gt; — khởi tạo toàn số 0 (lúc đầu ΔW = 0)&lt;br&gt;&amp;nbsp;&amp;nbsp;+ &lt;i&gt;r &amp;lt;&amp;lt; d&lt;/i&gt; (ví dụ r = 8 hoặc 16, giảm &amp;gt;99% tham số cần học)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Forward:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;y = W₀ · x + (α / r) · B · A · x&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Vị trí tiêm:&lt;/b&gt; Ma trận chiếu Self-Attention (&lt;i&gt;q_proj, v_proj&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Hậu huấn luyện (Weight Merge):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Cộng trực tiếp: &lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;W_mới = W₀ + (α / r) · B · A&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;→ &lt;i&gt;Không tốn thêm bất kỳ độ trễ nào khi chạy suy luận!&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Checkpoint:&lt;/b&gt; &lt;i&gt;checkpoints/lora.pt&lt;/i&gt; (chỉ vài MB) &amp;amp; &lt;i&gt;checkpoints/sft_lora_merged.pt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f8f5;strokeColor=#1abc9c;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3010" y="195" width="790" height="420" as="geometry" />
        </mxCell>

        <mxCell id="dpo_card" value="&lt;b&gt;CĂN CHỈNH SỞ THÍCH TRỰC TIẾP (DPO)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• &lt;b&gt;Mục tiêu:&lt;/b&gt; Căn chỉnh mô hình theo sở thích con người mà &lt;b&gt;KHÔNG CẦN&lt;/b&gt; huấn luyện Reward Model riêng hay giải thuật RL phức tạp.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Dữ liệu sở thích:&lt;/b&gt; Bộ ba &lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;(prompt x, y_chosen, y_rejected)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;+ &lt;i&gt;y_chosen&lt;/i&gt;: câu trả lời chuẩn, hay hơn, có ích hơn.&lt;br&gt;&amp;nbsp;&amp;nbsp;+ &lt;i&gt;y_rejected&lt;/i&gt;: câu trả lời dở, sai lệch, độc hại.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Kiến trúc 2 mô hình song song:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;1. &lt;b&gt;Reference Model (π_ref):&lt;/b&gt; Nạp từ SFT/LoRA và đóng băng cố định.&lt;br&gt;&amp;nbsp;&amp;nbsp;2. &lt;b&gt;Policy Model (π_θ):&lt;/b&gt; Mô hình đang được tối ưu hoá.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Hàm mất mát DPO:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;L_{DPO} = − log σ ( β · [ log(π_θ(y_w|x) / π_ref(y_w|x)) − log(π_θ(y_l|x) / π_ref(y_l|x)) ] )&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Đầu ra:&lt;/b&gt; &lt;i&gt;checkpoints/dpo.pt&lt;/i&gt; (Mô hình trả lời an toàn, trung thực, ưa chuộng các câu trả lời chất lượng cao)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9e7;strokeColor=#f39c12;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="3960" y="195" width="790" height="420" as="geometry" />
        </mxCell>

        <mxCell id="rlaif_card" value="&lt;b&gt;REINFORCEMENT LEARNING FROM AI FEEDBACK (RLAIF)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• &lt;b&gt;Mục tiêu:&lt;/b&gt; Phát triển năng lực lý luận sâu (Deep Reasoning), tự tư duy qua thẻ &lt;font face=&quot;Courier New&quot;&gt;&amp;lt;think&amp;gt;...&amp;lt;/think&amp;gt;&lt;/font&gt; và tự kiểm tra tính đúng đắn.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Vòng lặp GRPO (Group Relative Policy Optimization):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;1. &lt;b&gt;Rollout:&lt;/b&gt; Với mỗi prompt &lt;i&gt;x&lt;/i&gt;, mô hình Policy sinh ra một nhóm &lt;i&gt;G&lt;/i&gt; câu trả lời: &lt;font face=&quot;Courier New&quot;&gt;{y₁, y₂, ..., y_G}&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;2. &lt;b&gt;AI Feedback &amp;amp; Rule Reward:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ Thưởng độ dài, định dạng thẻ suy nghĩ &amp;lt;think&amp;gt;, phạt lặp từ.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ Đánh giá kết quả đúng/sai qua AI Verifier / Teacher Model.&lt;br&gt;&amp;nbsp;&amp;nbsp;3. &lt;b&gt;Lợi thế tương đối nhóm (Advantage):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;A_i = (r_i − mean(R)) / (std(R) + ε)&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&lt;i&gt;(BỎ QUA MẠNG CRITIC!)&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;4. &lt;b&gt;Policy Loss:&lt;/b&gt; PPO-Clip / CISPO + phạt phân kỳ &lt;font face=&quot;Courier New&quot;&gt;D_KL(π_θ || π_ref)&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Đầu ra:&lt;/b&gt; &lt;i&gt;checkpoints/rlaif.pt&lt;/i&gt; (Mô hình lý luận mạnh mẽ, giải toán, viết code chuẩn xác)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#8e44ad;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="4910" y="195" width="790" height="420" as="geometry" />
        </mxCell>

        <!-- Bridge connector from SFT to downstream -->
        <mxCell id="bridge_sft_downstream" value="Mô hình SFT làm nền tảng cho&lt;br&gt;PEFT, Alignment &amp;amp; RL" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#196f3d;fontColor=#196f3d;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sft_ckpt" target="lora_card">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2930" y="482" />
              <mxPoint x="2930" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="bridge_lora_dpo" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7f8c8d;dashed=1;" edge="1" parent="1" source="lora_card" target="dpo_card">
          <mxGeometry relative="1" as="geometry" />
