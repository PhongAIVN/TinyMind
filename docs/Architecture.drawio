        <!-- ========================================================================= -->
        <!-- SWIMLANE 1: PRETRAIN DETAILS                                              -->
        <!-- ========================================================================= -->
        <!-- Pretrain: Column Titles -->
        <mxCell id="pt_col1_title" value="A. Dữ liệu &amp; Tiền xử lý (Data Pipeline)" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2b5b84;" vertex="1" parent="1">
          <mxGeometry x="110" y="155" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pt_col2_title" value="B. Kiến trúc Model &amp; Forward Pass" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#6c3483;" vertex="1" parent="1">
          <mxGeometry x="560" y="155" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pt_col3_title" value="C. Hàm Loss, Tối ưu &amp; Checkpoint" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#196f3d;" vertex="1" parent="1">
          <mxGeometry x="1030" y="155" width="360" height="25" as="geometry" />
        </mxCell>

        <!-- Pretrain: Column 1 (Data) -->
        <mxCell id="pt_raw" value="&lt;b&gt;1. Dữ liệu văn bản thô (Raw Text)&lt;/b&gt;&lt;br&gt;&lt;i&gt;dataset/pretrain/train/part_00..08.txt&lt;/i&gt; (~174MB)&lt;br&gt;&lt;i&gt;dataset/pretrain/eval/part_09.txt&lt;/i&gt; (~19MB)&lt;br&gt;Nguồn ngữ liệu tiếng Việt sạch, đa dạng chủ đề" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="195" width="360" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pt_tok" value="&lt;b&gt;2. Byte-Level BPE Tokenizer&lt;/b&gt;&lt;br&gt;&lt;i&gt;tokenizer/train_tokenizer.py&lt;/i&gt; (vocab_size = 16.000)&lt;br&gt;19 token đặc biệt (id 0–18: &amp;lt;|im_start|&amp;gt;, &amp;lt;think&amp;gt;, &amp;lt;tool_call&amp;gt;...)&lt;br&gt;Tốc độ tokenize: ~15s cho 174MB (~35 triệu tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="290" width="360" height="75" as="geometry" />
        </mxCell>

        <mxCell id="pt_bin" value="&lt;b&gt;3. Lưu mảng ID dạng nhị phân uint16&lt;/b&gt;&lt;br&gt;&lt;i&gt;dataset/pretrain/tokens/train.bin&lt;/i&gt; (35.264.352 tokens, 70.5MB)&lt;br&gt;&lt;i&gt;dataset/pretrain/tokens/eval.bin&lt;/i&gt; (3.969.973 tokens)&lt;br&gt;Truy xuất nhanh qua mmap / đọc trực tiếp vào RAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="395" width="360" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pt_ds" value="&lt;b&gt;4. PretrainDataset &amp;amp; DataLoader&lt;/b&gt;&lt;br&gt;&lt;i&gt;trainer/pretrain_dataset.py&lt;/i&gt;&lt;br&gt;Cắt lát chuỗi liên tục độ dài &lt;b&gt;T&lt;/b&gt; = max_seq_len (≤ 512)&lt;br&gt;Xếp batch kích thước &lt;b&gt;B&lt;/b&gt;, drop_last=True, lặp vô hạn theo step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="490" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="pt_xy" value="&lt;b&gt;5. Cặp dữ liệu huấn luyện (Next-Token)&lt;/b&gt;&lt;br&gt;Nhãn &lt;b&gt;y&lt;/b&gt; là chuỗi token dịch 1 vị trí so với &lt;b&gt;x&lt;/b&gt;:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;x&lt;/b&gt; = [t₀, t₁, t₂, ..., t_{T-1}] &amp;nbsp;&lt;i&gt;(B, T)&lt;/i&gt;&lt;br&gt;&lt;b&gt;y&lt;/b&gt; = [t₁, t₂, t₃, ..., t_T] &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;(B, T)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="590" width="360" height="85" as="geometry" />
        </mxCell>

        <!-- Pretrain: Column 2 (Model Forward) -->
        <mxCell id="pt_in" value="input_ids &lt;b&gt;x&lt;/b&gt;&lt;br&gt;&lt;i&gt;(B, T)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="195" width="360" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pt_emb" value="&lt;b&gt;Token Embedding&lt;/b&gt; (V × d)&lt;br&gt;&lt;i&gt;core/embedding.py&lt;/i&gt; — V = 16.000, d = 256 / 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="265" width="360" height="50" as="geometry" />
        </mxCell>

        <mxCell id="pt_blocks" value="&lt;b&gt;L × Transformer Blocks&lt;/b&gt; (&lt;i&gt;core/block.py&lt;/i&gt;)&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• Pre-norm: &lt;b&gt;RMSNorm 1&lt;/b&gt; (&lt;i&gt;core/rmsnorm.py&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Causal Self-Attention&lt;/b&gt; (&lt;i&gt;core/attention.py&lt;/i&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;+ RoPE (cos, sin) vị trí tương đối (&lt;i&gt;core/rope.py&lt;/i&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;+ Causal Mask: che tương lai (j &amp;gt; i = −∞)&lt;br&gt;• Residual add: &lt;i&gt;h = h + Attn(norm(h))&lt;/i&gt;&lt;br&gt;• Pre-norm: &lt;b&gt;RMSNorm 2&lt;/b&gt;&lt;br&gt;• &lt;b&gt;SwiGLU FFN&lt;/b&gt;: (gate(x) · SiLU) ⊙ up(x) → down (&lt;i&gt;core/feedforward.py&lt;/i&gt;)&lt;br&gt;• Residual add: &lt;i&gt;h = h + FFN(norm(h))&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="345" width="360" height="175" as="geometry" />
        </mxCell>

        <mxCell id="pt_norm" value="&lt;b&gt;RMSNorm cuối&lt;/b&gt;&lt;br&gt;x / √(mean(x²) + ε) · w (tính fp32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="545" width="360" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pt_head" value="&lt;b&gt;lm_head&lt;/b&gt;: Linear(d → V, bias=False)&lt;br&gt;&lt;i&gt;(dùng chung ma trận trọng số với Token Embedding)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="615" width="360" height="45" as="geometry" />
        </mxCell>

        <mxCell id="pt_logits" value="logits &lt;b&gt;z&lt;/b&gt;&lt;br&gt;&lt;i&gt;(B, T, V)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="690" width="360" height="40" as="geometry" />
        </mxCell>

        <!-- Pretrain: Column 3 (Loss, Optim, Checkpoint) -->
        <mxCell id="pt_loss" value="&lt;b&gt;Next-Token Cross-Entropy Loss&lt;/b&gt;&lt;br&gt;&lt;i&gt;trainer/losses.py: next_token_loss(logits, y)&lt;/i&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;L = − 1/(B·T) ∑_{t=1}^T log P(y_t | x_{≤t})&lt;/b&gt;&lt;/font&gt;&lt;br&gt;F.cross_entropy(logits.view(−1, V), y.view(−1))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="195" width="360" height="85" as="geometry" />
        </mxCell>

        <mxCell id="pt_optim" value="&lt;b&gt;Tối ưu hoá &amp;amp; Lập lịch LR&lt;/b&gt; (&lt;i&gt;trainer/optim.py, lr_scheduler.py&lt;/i&gt;)&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• Bộ tối ưu: &lt;b&gt;AdamW&lt;/b&gt; (β₁ = 0.9, β₂ = 0.95, eps = 1e−8)&lt;br&gt;• Tách weight decay = 0.1 (không áp dụng lên norm &amp;amp; bias)&lt;br&gt;• Scheduler: &lt;b&gt;Cosine Annealing with Warmup&lt;/b&gt;&lt;br&gt;• Gradient Clipping: max_norm = 1.0 (chống nổ đạo hàm)&lt;br&gt;• Tự động kết hợp AMP (fp16/bf16) + GradScaler khi có GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="305" width="360" height="120" as="geometry" />
        </mxCell>

        <mxCell id="pt_stats" value="&lt;b&gt;Kết quả Pretrain thực tế (Config Tiny — 2000 steps):&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;• Tổng tham số mô hình: &lt;b&gt;2.425.472 tham số&lt;/b&gt; (~2.4M)&lt;br&gt;• Đã học qua: &lt;b&gt;8,19 triệu tokens&lt;/b&gt; (2000 bước, batch=8, T=512)&lt;br&gt;• &lt;b&gt;Val Loss:&lt;/b&gt; 9.705 (chưa train) → &lt;b&gt;5.030&lt;/b&gt; (sau 2000 bước)&lt;br&gt;• &lt;b&gt;Perplexity:&lt;/b&gt; 16.408 → &lt;b&gt;153&lt;/b&gt; (hội tụ rõ rệt)&lt;br&gt;• Tốc độ: ~10.000 tokens/giây trên CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="450" width="360" height="125" as="geometry" />
        </mxCell>

        <mxCell id="pt_ckpt" value="&lt;b&gt;ĐẦU RA PRETRAIN: BASE MODEL CHECKPOINT&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;3&quot; color=&quot;#1b4f72&quot;&gt;&lt;b&gt;checkpoints/pretrain.pt&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lưu: model state_dict, optimizer, scheduler, step, metrics&lt;br&gt;Mô hình có năng lực sinh từ ngữ tự nhiên, ngữ pháp tiếng Việt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;shadow=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="600" width="360" height="75" as="geometry" />
        </mxCell>

        <mxCell id="pt_note" value="&lt;i&gt;Nguyên lý cốt lõi:&lt;/i&gt; Pretrain cung cấp cho mô hình &quot;thế giới quan&quot; và kiến thức ngôn ngữ nền tảng bằng cách dự đoán token kế tiếp trên lượng lớn văn bản không giám sát." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1030" y="695" width="360" height="45" as="geometry" />
        </mxCell>

