{
  "model": {
    "vocab_size": 32000,
    "num_layers": 12,
    "hidden_size": 512,
    "num_heads": 8,
    "head_dim": 64,
    "intermediate_size": 1536,
    "context_length": 2048,
    "rope_theta": 10000.0,
    "norm_eps": 1e-6,
    "dropout": 0.0,
    "tie_embeddings": true
  },
  "train": {
    "train_data_path": "data/train.bin",
    "val_data_path": "data/val.bin",
    "sequence_length": 2048,
    "batch_size": 8,
    "gradient_accumulation_steps": 4,
    "max_steps": 10000,
    "learning_rate": 3e-4,
    "min_learning_rate": 3e-5,
    "warmup_steps": 500,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip_norm": 1.0,
    "precision": "bf16",
    "compile_model": false,
    "log_interval": 10,
    "eval_interval": 500,
    "eval_steps": 50,
    "checkpoint_interval": 1000,
    "checkpoint_dir": "checkpoints",
    "seed": 42
  }
}
